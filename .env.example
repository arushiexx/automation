# ===========================================
# WhatsApp Auto-Reply System - Configuration
# ===========================================

# Meta WhatsApp Business API Token
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_api_token_here

# Phone Number ID (Meta assigns this to your WhatsApp Business number)
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Verify Token (kuch bhi random string daal do - tum khud set karte ho)
VERIFY_TOKEN=my_secret_verify_token_123

# Auto-Reply Message (ye message naye customer ko jayega)
AUTO_REPLY_MESSAGE=Demo ₹39\nFree me demo nahi milega ❌\n\nMeri photo channel me upload hai jaakr dekh lo 👇\n\nJise service chahiye YES likh ke msg kare, rate list bhejungi 💕\n\n📌 Channel: https://whatsapp.com/channel/YOUR_CHANNEL_LINK

# Server Port
PORT=3000
